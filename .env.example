# Copy to services/api/.env (never commit the real file). Every variable is optional.

# --- AI -------------------------------------------------------------------------------------------
# Leave both keys empty to run fully offline (deterministic heuristic engine). Kairos tries Claude, then
# Gemini, for whichever has a key, for language understanding, meeting briefs and message polishing;
# any failure falls back to the next engine and finally to the offline engine.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# auto = Claude then Gemini (whichever have keys) | offline = never call an LLM
# claude = always try Claude first | gemini = Gemini only
KAIROS_AI_MODE=auto
KAIROS_MODEL=claude-opus-5-5
KAIROS_AI_TIMEOUT_S=25
# Command parsing gets a tighter budget (no retry) before falling back to the offline parse
KAIROS_AI_PARSE_TIMEOUT_S=8
# Gemini models (Gemini Developer API): writing (briefs, drafts) and fast (parsing; fallback when busy)
KAIROS_GEMINI_MODEL=gemini-3.5-flash-lite
KAIROS_GEMINI_FAST_MODEL=gemini-3.1-flash-lite

# --- Data & demo ------------------------------------------------------------------------------------
# Default: services/api/.data/kairos.db (outside OneDrive when set up with scripts/setup.ps1)
# KAIROS_DATABASE_URL=sqlite:///C:/path/to/kairos.db
KAIROS_SEED=7
# Freeze the clock for reproducible demos, e.g. 2026-11-30T16:00:00Z (also settable in Settings > Demo controls)
# KAIROS_NOW=

# --- Optional Google Calendar connector -----------------------------------------------------------------
# uv sync --extra google, then point to an OAuth client JSON (Desktop app, Calendar API enabled)
# KAIROS_GOOGLE_CLIENT_SECRETS=C:/path/to/client_secret.json
